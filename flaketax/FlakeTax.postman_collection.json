{
  "info": {
    "name": "FlakeTax local API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Switch the handle/pass variables between host1, alex1 and sam1 to simulate different players."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{handle}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{pass}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "handle",
      "value": "host1"
    },
    {
      "key": "pass",
      "value": "localtest123"
    },
    {
      "key": "pactId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "2"
    },
    {
      "key": "deadline",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register current handle",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"handle\": \"{{handle}}\",\n  \"password\": \"{{pass}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "My balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "me"
          ]
        }
      }
    },
    {
      "name": "Create pact as host",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Study Java for two hours\",\n  \"stake\": 100,\n  \"deadline\": \"{{deadline}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('deadline', new Date(Date.now() + 15 * 60 * 1000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('pactId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "My pacts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacts"
          ]
        }
      }
    },
    {
      "name": "View pact",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacts/{{pactId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacts",
            "{{pactId}}"
          ]
        }
      }
    },
    {
      "name": "Join as another user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacts/{{pactId}}/join",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacts",
            "{{pactId}}",
            "join"
          ]
        }
      }
    },
    {
      "name": "Send proof",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacts/{{pactId}}/proof",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacts",
            "{{pactId}}",
            "proof"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"note\": \"I finished the two hours of Java.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Approve as host",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacts/{{pactId}}/review/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacts",
            "{{pactId}}",
            "review",
            "{{userId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"approved\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Settle after review period",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pacts/{{pactId}}/settle",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pacts",
            "{{pactId}}",
            "settle"
          ]
        }
      }
    },
    {
      "name": "My ledger",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/me/entries",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "me",
            "entries"
          ]
        }
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/actuator/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}